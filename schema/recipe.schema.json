{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalog.renplay.org/recipe.schema.json",
  "title": "renplay recipe",
  "description": "Recipes build into schema 4 indexes. https://catalog.renplay.org/index.v4.sfw.json excludes adult games, game content fields and the content vocabulary group.",
  "type": "object",
  "required": ["id", "title", "releases"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$", "description": "Also the file name and the game's id in renplay" },
    "title": { "type": "string", "minLength": 1 },
    "developer": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string", "enum": ["2d-game","2dcg","3d-game","3dcg","adventure","ai-cg","animated","character-creation","combat","dating-sim","dystopian-setting","fantasy","female-protagonist","horror","humor","kinetic-novel","male-protagonist","management","multiple-endings","multiple-protagonist","paranormal","parody","platformer","point-click","puzzle","real-porn","religion","romance","rpg","sandbox","school-setting","sci-fi","shooter","side-scroller","simulator","strategy","superpowers","text-based","turn-based-combat","virtual-reality","voiced"] }, "maxItems": 10, "uniqueItems": true, "description": "Non-content ids from schema/tags.json; library chips" },
    "content": { "type": "array", "items": { "type": "string", "enum": ["ahegao","anal-sex","asset-addon","asset-ai-shoujo","asset-animal","asset-animation","asset-audio","asset-bundle","asset-character","asset-clothing","asset-daz-gen1","asset-daz-gen2","asset-daz-gen3","asset-daz-gen8","asset-daz-gen81","asset-daz-gen9","asset-daz-m4","asset-daz-v4","asset-environment","asset-expression","asset-female","asset-hair","asset-hdri","asset-honey-select","asset-honey-select2","asset-koikatu","asset-light","asset-male","asset-morph","asset-nonbinary","asset-playhome","asset-plugin","asset-pose","asset-prop","asset-scene","asset-script","asset-shader","asset-texture","asset-utility","asset-vehicle","bdsm","bestiality","big-ass","big-tits","blackmail","bukkake","censored","cheating","corruption","cosplay","creampie","dilf","drugs","exhibitionism","femaledomination","footjob","furry","futa-trans","futa-trans-protagonist","gay","graphic-violence","groping","group-sex","handjob","harem","humiliation","incest","internal-view","interracial","japanese-game","lactation","lesbian","loli","maledomination","masturbation","milf","mind-control","mobile-game","monster","monster-girl","multiple-penetration","necrophilia","no-sexual-content","ntr","oral-sex","possession","pov","pregnancy","prostitution","rape","scat","sex-toys","sexual-harassment","shota","sissification","slave","sleep-sex","spanking","stripping","swinging","teasing","tentacles","titfuck","trainer","transformation","trap","twins","urination","vaginal-sex","virgin","vore","voyeurism","unknown"] }, "uniqueItems": true, "description": "Content ids from schema/tags.json; searchable, never library chips" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 600, "pattern": "^[^<>]*$", "description": "Safe-for-work plain-text premise, one to three sentences; no markup" },
    "state": { "enum": ["ongoing", "completed", "on-hold", "abandoned"], "default": "ongoing", "description": "Game development state, not per-release playability; F95 Completed/Onhold/Abandoned prefixes, otherwise ongoing" },
    "nsfw": { "type": "boolean" },
    "free": { "type": "boolean", "description": "The release in this recipe is free to download from its developer, with no payment or subscription; omit when unknown" },
    "phone": { "enum": ["great", "playable", "desktop"], "description": "Curated phone rating, set only by a maintainer who tried the game on a phone: great (Great on phones), playable (Playable on phones), desktop (Needs a bigger screen). Never guessed; omit when untried" },
    "art": {
      "type": "array",
      "description": "The game's pictures in SteamGridDB's formats. The default of a kind is the image that says default: true, else the first one in the format's shape, else the first. Adult games may link SteamGridDB, Steam, itch.io or covers.renplay.org, never a repository file.",
      "items": {
        "type": "object",
        "required": ["kind", "url", "source"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["grid", "wide", "hero", "logo", "icon"], "description": "grid 600x900, wide 920x430, hero 1920x620 (an exact 2x of each is the same shape), logo a transparent PNG of any size, icon a square of 512 and up" },
          "url": { "type": "string", "pattern": "^(https://.+|covers/[a-z0-9]+(-[a-z0-9]+)*\\.webp)$", "description": "The image's https URL on the developer's or store's hosting, or covers/<id>.webp (safe-for-work games only)" },
          "source": { "enum": ["steam", "itch", "sgdb", "renplay", "developer"], "description": "Who published the art: a store (steam, itch), SteamGridDB (sgdb), Renplay-made art (renplay), or the developer" },
          "focal": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 }, "minItems": 2, "maxItems": 2, "description": "Where the picture matters, [x, y] from 0 to 1; forces a crop into missing formats" },
          "dark": { "type": "boolean", "description": "A dark logo, inverted on ink" },
          "default": { "type": "boolean", "description": "The chosen image of its kind; at most one per kind" },
          "sgdb": { "type": "integer", "minimum": 1, "description": "SteamGridDB asset id; referenced by id, never copied" },
          "by": { "type": "string", "minLength": 1, "description": "The SteamGridDB author, credited everywhere the art shows" },
          "byUrl": { "type": "string", "pattern": "^https://", "description": "The SteamGridDB author's profile page" },
          "animated": { "type": "string", "pattern": "^https://", "description": "SteamGridDB animated twin (WebP or APNG) of this image" },
          "adult": { "type": "boolean", "description": "SteamGridDB tags this asset adult" }
        },
        "allOf": [
          {
            "if": { "properties": { "source": { "const": "sgdb" } }, "required": ["source"] },
            "then": { "required": ["sgdb", "by", "byUrl"] },
            "else": { "not": { "anyOf": [{ "required": ["sgdb"] }, { "required": ["by"] }, { "required": ["byUrl"] }, { "required": ["animated"] }, { "required": ["adult"] }] } }
          }
        ]
      }
    },
    "links": {
      "type": "object",
      "propertyNames": { "enum": ["website", "patreon", "itch", "f95", "steam", "subscribestar", "discord", "walkthrough"] },
      "additionalProperties": { "type": "string", "pattern": "^https://" }
    },
    "engine": { "enum": ["renpy", "html", "godot", "unity"], "default": "renpy", "description": "What made the game. Renplay is for Ren'Py games; the others play with fewer features (docs/engines.md in renplay-org/renplay)" },
    "saveDir": { "type": "string", "minLength": 1, "description": "Where the game keeps its saves: config.save_directory for Ren'Py" },
    "continuesFrom": { "type": "array", "items": { "type": "string" }, "description": "Recipe ids of games whose saves this one imports" },
    "match": { "type": "array", "items": { "type": "string" }, "description": "Archive name patterns (*) for releases not listed yet" },
    "runtime": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "Web runtime to build every release with, from renplay-org/engines (default: the newest that fits the game)" },
    "notes": { "type": "string" },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "optimizeImages": { "type": "boolean" },
        "imageQuality": { "type": "integer", "minimum": 50, "maximum": 100 },
        "keep": { "type": "array", "items": { "type": "string" }, "description": "Globs (relative to game/) packed into game.zip instead of streaming" },
        "exclude": { "type": "array", "items": { "type": "string" }, "description": "Globs (relative to game/) left out of the build" },
        "patches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "file"],
            "additionalProperties": false,
            "properties": { "path": { "type": "string", "pattern": "^game/" }, "file": { "type": "string" } }
          }
        }
      }
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "status", "archives"],
        "additionalProperties": false,
        "properties": {
          "version": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "madeWith": { "type": "string", "description": "Version of the engine the game was made with: 8.2.1 (Ren'Py), 4.6.2 (Godot), 2.36.1 (SugarCube)" },
          "runtime": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "Web runtime for this release, instead of the recipe's" },
          "status": { "enum": ["verified", "playable", "broken", "untested"] },
          "archives": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "size": { "type": "integer", "minimum": 1 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "platform": { "enum": ["pc", "linux", "mac", "android", "universal", "web"] }
              }
            }
          },
          "verified": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "date": { "type": "string", "format": "date" },
              "renplay": { "type": "string" },
              "browsers": { "type": "array", "items": { "type": "string" } },
              "notes": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
