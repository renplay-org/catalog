{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "renplay recipe",
  "type": "object",
  "required": ["id", "title", "releases"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
    "title": { "type": "string", "minLength": 1 },
    "developer": { "type": "string" },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "nsfw": { "type": "boolean" },
    "cover": { "type": "string", "description": "Path under covers/ or an absolute https URL" },
    "links": { "type": "object", "additionalProperties": { "type": "string", "format": "uri" } },
    "saveDir": { "type": "string", "description": "config.save_directory of the game" },
    "notes": { "type": "string" },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "status", "archives"],
        "additionalProperties": false,
        "properties": {
          "version": { "type": "string" },
          "date": { "type": "string" },
          "renpy": { "type": "string" },
          "status": { "enum": ["verified", "playable", "broken", "untested"] },
          "archives": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "pattern": { "type": "string" },
                "size": { "type": "integer" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "platform": { "type": "string" }
              }
            }
          },
          "verified": {
            "type": "object",
            "properties": { "date": { "type": "string" }, "renplay": { "type": "string" }, "sdk": { "type": "string" }, "notes": { "type": "string" } }
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "optimizeImages": { "type": "boolean" },
        "imageQuality": { "type": "integer", "minimum": 50, "maximum": 100 },
        "progressiveRules": { "type": "string" },
        "patches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "file"],
            "properties": { "path": { "type": "string", "pattern": "^game/" }, "file": { "type": "string" } }
          }
        }
      }
    }
  }
}
