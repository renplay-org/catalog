{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "renplay recipe",
  "type": "object",
  "required": ["id", "title", "releases"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$", "description": "Also the file name and the game's id in renplay" },
    "title": { "type": "string", "minLength": 1 },
    "developer": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string", "maxLength": 40 }, "maxItems": 20 },
    "nsfw": { "type": "boolean" },
    "cover": { "type": "string", "pattern": "^covers/[a-z0-9]+(-[a-z0-9]+)*\\.webp$", "description": "covers/<id>.webp: 16:9 WebP, 1280 to 1920 pixels wide, under 400 KB" },
    "links": {
      "type": "object",
      "propertyNames": { "enum": ["website", "patreon", "itch", "f95", "steam", "subscribestar", "discord", "walkthrough"] },
      "additionalProperties": { "type": "string", "pattern": "^https://" }
    },
    "saveDir": { "type": "string", "minLength": 1, "description": "config.save_directory of the game" },
    "continuesFrom": { "type": "array", "items": { "type": "string" }, "description": "Recipe ids of games whose saves this one imports" },
    "match": { "type": "array", "items": { "type": "string" }, "description": "Archive name patterns (*) for releases not listed yet" },
    "engine": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "Ren'Py web engine to build with (default: newest of the game's major version)" },
    "notes": { "type": "string" },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "optimizeImages": { "type": "boolean" },
        "imageQuality": { "type": "integer", "minimum": 50, "maximum": 100 },
        "keep": { "type": "array", "items": { "type": "string" }, "description": "Globs (relative to game/) packed into game.zip instead of streaming" },
        "exclude": { "type": "array", "items": { "type": "string" }, "description": "Globs (relative to game/) left out of the build" },
        "patches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "file"],
            "additionalProperties": false,
            "properties": { "path": { "type": "string", "pattern": "^game/" }, "file": { "type": "string" } }
          }
        }
      }
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "status", "archives"],
        "additionalProperties": false,
        "properties": {
          "version": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "renpy": { "type": "string" },
          "engine": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "status": { "enum": ["verified", "playable", "broken", "untested"] },
          "archives": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "size": { "type": "integer", "minimum": 1 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "platform": { "enum": ["pc", "linux", "mac", "android", "universal"] }
              }
            }
          },
          "verified": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "date": { "type": "string", "format": "date" },
              "renplay": { "type": "string" },
              "browsers": { "type": "array", "items": { "type": "string" } },
              "notes": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
